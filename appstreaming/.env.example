# ============================================
# VARIABLES D'ENVIRONNEMENT REQUISES
# ============================================
# Copier ce fichier en .env et remplir avec vos valeurs réelles
# NE JAMAIS commiter le fichier .env dans Git

# ========== Base de données ==========
DB_URL=jdbc:postgresql://localhost:5432/streaming
DB_USERNAME=your_db_user
DB_PASSWORD=your_secure_db_password
POSTGRES_DB=streaming
POSTGRES_USER=postgres
POSTGRES_PASSWORD=your_postgres_password

# ========== Email (SMTP) ==========
MAIL_USERNAME=your-email@gmail.com
MAIL_PASSWORD=your_app_specific_password
MAIL_FROM=noreply@yourapp.com

# ========== Frontend ==========
FRONTEND_URL=http://localhost:5173
APP_FRONTEND_URL=http://localhost:5173

# ========== Ant Media Server ==========
ANTMEDIA_URL=http://your-antmedia-server:5080
ANTMEDIA_APP=LiveApp
REPLAY_URL=http://your-antmedia-server:5080/LiveApp/streams
ANTMEDIA_SERVER_URL=http://your-antmedia-server:5080

# ========== Sécurité ==========
# Générer JWT secret avec: openssl rand -base64 64
JWT_SECRET=your-very-long-secure-jwt-secret-key-minimum-256-bits
WEBHOOK_SECRET=your-webhook-secret-shared-with-antmedia

# ========== Profil Spring ==========
# Choisir: dev, prod
SPRING_PROFILES_ACTIVE=dev

# ========== Optionnel: Stockage S3/MinIO ==========
#STORAGE_TYPE=s3
#STORAGE_S3_ACCESS_KEY=your_access_key
#STORAGE_S3_SECRET_KEY=your_secret_key
#STORAGE_S3_BUCKET_NAME=appstreaming-files
#STORAGE_S3_REGION=us-east-1
#STORAGE_S3_ENDPOINT=http://localhost:9000

# ========== Optionnel: Cloudinary ==========
#STORAGE_TYPE=cloudinary
#STORAGE_CLOUDINARY_CLOUD_NAME=your_cloud_name
#STORAGE_CLOUDINARY_API_KEY=your_api_key
#STORAGE_CLOUDINARY_API_SECRET=your_api_secret
